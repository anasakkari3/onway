rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requesting user a confirmed/active member of a trip?
    // Membership doc ID: {tripId}_{userId}
    function isTripMember(tripId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/trip_memberships/$(tripId + '_' + request.auth.uid));
    }

    // ── Trips ────────────────────────────────────────────────────────────────
    // Any authenticated user can read trip data (trips are visible within
    // the platform to all logged-in members). All writes go through the
    // server-side Admin SDK, which bypasses these rules entirely.
    match /trips/{tripId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Bookings ─────────────────────────────────────────────────────────────
    // Readable by any trip member (the driver sees the full roster; passengers
    // can see who else is on board). Writes are server-only.
    match /bookings/{bookingId} {
      allow read: if resource != null && isTripMember(resource.data.trip_id);
      allow write: if false;
    }

    // ── Messages ─────────────────────────────────────────────────────────────
    // Only trip members may read the chat for that trip. Writes are server-only.
    match /messages/{messageId} {
      allow read: if resource != null && isTripMember(resource.data.trip_id);
      allow write: if false;
    }

    // ── Trip Memberships ─────────────────────────────────────────────────────
    // Users may read only their own membership doc (used as an in-session
    // revocation signal in the chat and trip-detail clients).
    match /trip_memberships/{docId} {
      allow read: if request.auth != null &&
        resource != null &&
        resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    // ── Everything else ──────────────────────────────────────────────────────
    // All other collections (users, communities, reports, notifications, …)
    // are accessed exclusively via server-side Admin SDK calls, which bypass
    // these rules. Direct client access is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
